{
  "name": "clareza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "npx --yes tsx --test src/lib/regime/engine.test.ts src/lib/stats/context.test.ts src/lib/viz/squarify.test.ts src/lib/history/deltas.test.ts src/lib/reading/reading.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "snapshots:refresh": "npx --yes tsx scripts/refresh-snapshots.ts",
    "ci": "npm run lint && npm run typecheck && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lightweight-charts": "^5.2.0",
    "next": "16.2.11",
    "next-intl": "^4.13.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
