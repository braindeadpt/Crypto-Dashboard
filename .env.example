# Optional — enrich editorial brief via OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CoinGecko Demo key (recomendado) — evita 429; header x-cg-demo-api-key
# Obtém em: https://www.coingecko.com/en/api/pricing (plano Demo grátis)
COINGECKO_DEMO_API_KEY=


# Etherscan API V2 (gratuito � etherscan.io -> API Keys)
# Usado pela /carteira; utilizadores podem trazer a propria chave (BYOK)
ETHERSCAN_API_KEY=

# URL publico do site � sitemap.xml/robots.txt/feed.xml (definir ao lancar)
NEXT_PUBLIC_SITE_URL=

# CoinGecko Pro key (opcional - alternativa ao Demo; header x-cg-pro-api-key)
COINGECKO_API_KEY=

# Obrigatório se a rota cron estiver exposta — POST /api/cron/refresh-heavy
# exige "Authorization: Bearer <isto>" (503 sem isto definido, 401 com outro valor)
CRON_SECRET=
